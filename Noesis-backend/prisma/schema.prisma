datasource db {
  provider = "postgresql"
}


generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model Notebook {
  id        String   @id @default(uuid())
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sources   Source[]
}

model Source {
  id           String   @id @default(uuid())
  notebookId   String
  notebook     Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  type         String   // "PDF" | "TEXT" | "URL" | "YOUTUBE" | "VTT"
  title        String
  originalUrl  String?
  filePath     String?  // Path to the file if saved locally on the server
  status       String   // "UPLOADING" | "EXTRACTING" | "CHUNKING" | "EMBEDDING" | "READY" | "FAILED"
  errorMessage String?
  metadata     String?  // JSON-serialized metadata
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  chunks       Chunk[]
}

model Chunk {
  id          String   @id @default(uuid())
  sourceId    String
  source      Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  text        String
  page        Int?
  startTime   Float?
  endTime     Float?
  charStart   Int?
  charEnd     Int?
  embedding   String   // JSON-serialized array of floats (1536 dimensions for text-embedding-3-small)
  createdAt   DateTime @default(now())
}
