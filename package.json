{
  "name": "noesis",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "Noesis-frontend",
    "Noesis-backend"
  ],
  "scripts": {
    "frontend": "npm run dev --workspace=Noesis-frontend",
    "backend": "npm run dev --workspace=Noesis-backend",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "build": "npm run build --workspaces",
    "install:all": "npm install --workspaces",
    "start:backend": "npm run start --workspace=Noesis-backend",
    "start:frontend": "npm run start --workspace=Noesis-frontend",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}